        "sha256": "f4522420190da27838450462dea0b894fcf00848f9b1ab278d1be345d7b3bc7e"
      },
      "YUAUY_Wallpaper/Image/ImagePicker.cs": {
        "sha256": "5bed974efdc9babc837be9af21e51900588ce90d58b4594420b55d03b68c2bb7"
      }
    },
    "method": "source extraction; C# executable was not run"
  },
  "verbatim_csharp_expressions": {
    "area_selection": "s = s.Select(size => size / s.Sum()).ToArray();",
    "frame_delay": "int delay = 40;",
    "image_aspect": "var irs = (float)img.Width / img.Height;",
    "image_scale": "var rsx = Math.Abs(irs - srs) * 0.1 + 0.8;",
    "old_alpha": "brushA.Color = Color.FromArgb((int)(timeA * 175), 0, 0, 0);",
    "old_scale": "var rrsst = 1 - rrss * timeA;",
    "picker_extensions": "SupportFiles.Contains(path.ToUpper().Split('.')[^1])",
    "picker_rescan": "_lastFileCount != ImageFolderList.Sum(path => Directory.GetFiles(path).Length)",
    "picker_sequence": "if (_index >= _imagePaths.Length) _index = 0;",
    "picker_shuffle": "imagePathsTmp = imagePathsTmp.OrderBy(path => random2.Next(imagePathsTmp.Count()));",
    "picker_zero_image": "return null;",
    "random_rotation": "var r = random.Next(-20, 20);",
    "random_x": "float x = random.Next((int)(Screen.AllScreens[nextScreen].Bounds.Width * 0.4));",
    "screen_aspect": "var srs = (float)Screen.AllScreens[nextScreen].Bounds.Width / Screen.AllScreens[nextScreen].Bounds.Height;",
    "screen_choice": "st -= t;",
    "time_a": "float timeA = 1 - 1.2f / MathF.Cosh(time * 3f * MathF.PI + 0.65f);",
    "time_step": "time += first ? 1 : 0.03f",
    "white_reveal_a": "timeB = 1 / MathF.Cosh((timeB - 1) * 2f * MathF.PI);",
    "white_reveal_b": "timeB = 1 - 1 / MathF.Cosh(timeB * 2f * MathF.PI);"
  }
}
